{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mmh3_media.schema.json",
  "title": "MMH3_MEDIA packet.json schema v1",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "id",
    "name",
    "generation",
    "notes",
    "resources",
    "history",
    "extensions"
  ],
  "properties": {
    "format": {
      "const": "MMH3_MEDIA"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "generation": {
      "type": "object"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "role",
          "slot",
          "path",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "latent",
              "image",
              "video",
              "audio",
              "mask",
              "json"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object",
            "properties": {
              "h3": {
                "type": "object",
                "properties": {
                  "latent_context": {
                    "type": "object",
                    "properties": {
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "model_family": {
                        "type": "string"
                      },
                      "layout": {
                        "type": "string"
                      },
                      "origin": {
                        "enum": [
                          "unknown",
                          "sampler_output",
                          "vae_encoded",
                          "derived"
                        ]
                      },
                      "temporal_grid": {
                        "type": "string"
                      },
                      "canvas": {
                        "type": "object",
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "additionalProperties": true
                      },
                      "frames": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "fps": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "video_latent_t": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "audio_latent_t": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "audio_sample_rate": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "audio_latent_rate": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "batch": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "continuation": {
                        "type": "object"
                      },
                      "seam_source": {
                        "type": "object"
                      },
                      "naive_latent_concat_safe": {
                        "const": false
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "serializer": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "preview"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "sha256"
                ]
              }
            }
          }
        ]
      }
    },
    "history": {
      "type": "array"
    },
    "extensions": {
      "type": "object"
    },
    "notes": {
      "type": "string",
      "description": "Free-form creator/user notes. Empty string by default."
    }
  },
  "additionalProperties": true
}
