{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mmh3_media.schema.json",
  "title": "MMH3_MEDIA packet.json schema v2",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "id",
    "name",
    "generation",
    "notes",
    "primary",
    "resources",
    "representations",
    "history",
    "extensions"
  ],
  "properties": {
    "format": {
      "const": "MMH3_MEDIA"
    },
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    },
    "primary": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "video",
          "audio",
          "image",
          "latent",
          "mask"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "representations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "role",
        "order",
        "tags",
        "path",
        "media_type",
        "serializer",
        "descriptor",
        "provenance",
        "content",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "latent",
            "image",
            "video",
            "audio",
            "mask",
            "json"
          ]
        },
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "reference",
            "control",
            "context",
            "intermediate",
            "auxiliary"
          ]
        },
        "order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "serializer": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptor": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        },
        "content": {
          "type": "object",
          "required": [
            "revision",
            "digest",
            "size"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "extensions": {
          "type": "object"
        }
      },
      "not": {
        "required": [
          "slot"
        ]
      },
      "additionalProperties": true
    }
  }
}
